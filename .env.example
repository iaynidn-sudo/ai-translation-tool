# 客户需求调研纪要工具配置（.env）
# 复制本文件为 .env 后填写你的配置。
# 内置模型 tiny/base/small/medium/large-v3 为系统内置，无需配置。
# AI 后端 BACKEND 支持 openai / ollama；openai 需配置 API_KEY、OPENAI_BASE_URL、OPENAI_MODEL
# 自定义模型以 MODEL_ 前缀定义：MODEL_1_NAME / MODEL_1_PATH / MODEL_1_KEY / MODEL_1_DESC / MODEL_1_ENABLED / MODEL_1_LOCKED

BACKEND=ollama
API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
WHISPER_MODEL=small
EXPORT_FMT=md

# 自定义本地 Whisper 模型示例（有多个模型时依次写 MODEL_2_NAME 等）：
# MODEL_1_NAME=中文优化版
# MODEL_1_PATH=D:/models/whisper-small-zh
# MODEL_1_KEY=
# MODEL_1_DESC=本地中文优化模型
# MODEL_1_ENABLED=true
# MODEL_1_LOCKED=false
